# Environment variables (sample - do not put real secrets here)
# Copy to .env and configure for your environment

# Database (PostgreSQL + PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bloodlink
DB_USER=bloodlink_user
DB_PASSWORD=bloodlink_secret
DB_URL=jdbc:postgresql://localhost:5432/bloodlink

# Security & JWT
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_MIN=15
JWT_REFRESH_DAYS=7

# Bootstrap Admin
ADMIN_EMAIL=admin@bloodlink.lk
ADMIN_PASSWORD=AdminSecurePassword123!

# AI Service
AI_SERVICE_URL=http://localhost:8000

# Firebase
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=bloodlink-lk

# CORS & Server
SERVER_PORT=8080
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://10.0.2.2:8080

# Mobile (Dart define)
API_BASE_URL=http://localhost:8080
WS_URL=ws://localhost:8080/ws
